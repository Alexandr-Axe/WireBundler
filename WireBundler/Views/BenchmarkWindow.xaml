<Window x:Class="WireBundler.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wire Bundler Benchmark"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Wire Packing Solver Benchmark"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Benchmark configuration"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Input file path:"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="BenchmarkInputFileTextBox"
                             Width="220"
                             Margin="0,0,0,4"
                             Text="input.txt"/>

                    <TextBlock Text="{Binding FallbackDescription}"
                               Margin="0,8,0,4"/>

                    <TextBlock Text="{Binding SurvivorDescription}"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding FineOffsetDescription}"
                               Margin="0,0,0,4"/>

                    <Button x:Name="RunBenchmarkButton"
                            Content="Run benchmark"
                            Width="160"
                            Height="28"
                            Margin="0,12,0,0"
                            Click="RunBenchmarkButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Benchmark progress"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ProgressBar x:Name="BenchmarkProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="16"
                                 Margin="0,0,0,8"/>

                    <TextBlock x:Name="BenchmarkStatusTextBlock"
                               Text="Benchmark not started."
                               Margin="0,4,0,8"
                               Foreground="DimGray"/>

                    <TextBlock Text="Current best configuration:"
                               FontWeight="SemiBold"
                               Margin="0,4,0,4"/>

                    <TextBox x:Name="BestConfigTextBox"
                             Height="120"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Estimated total time:"
                               FontWeight="SemiBold"
                               Margin="0,8,0,4"/>

                    <TextBlock x:Name="EstimatedTotalTimeTextBlock"
                               Text="-"
                               Margin="0,0,0,4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>