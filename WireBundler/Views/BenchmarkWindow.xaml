<Window x:Class="WireBundler.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wire Bundler Benchmark"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Wire Packing Solver Benchmark"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Benchmark configuration"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Input file path:"
                               Margin="0,0,0,4"/>
                    
                    <TextBox x:Name="BenchmarkInputFileTextBox"
                             Width="220"
                             Margin="0,0,0,4"
                             Text="input.txt"/>

                    <TextBlock Text="Fallback directions"
                               FontWeight="SemiBold"
                               Margin="0,8,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Start:" Width="80"/>
                        <TextBox Width="60" Text="{Binding FallbackDirectionStart, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Limit:" Width="80"/>
                        <TextBox Width="60" Text="{Binding FallbackDirectionLimit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Step:" Width="80"/>
                        <TextBox Width="60" Text="{Binding FallbackDirectionStep, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="Coarse survivors"
                               FontWeight="SemiBold"
                               Margin="0,8,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Survivor limit:" Width="120"/>
                        <TextBox Width="60" Text="{Binding SurvivorCountLimit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="Fine offset" 
                               FontWeight="SemiBold"
                               Margin="0,8,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Min:" Width="80"/>
                        <TextBox Width="60" Text="{Binding MinFineAngularOffset, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Max:" Width="80"/>
                        <TextBox Width="60" Text="{Binding MaxFineAngularOffset, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Step:" Width="80"/>
                        <TextBox Width="60" Text="{Binding FineAngularOffsetStep, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Button x:Name="RunBenchmarkButton"
                            Content="Run benchmark"
                            Width="160"
                            Height="28"
                            Margin="0,12,0,0"
                            Click="RunBenchmarkButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Benchmark progress"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ProgressBar x:Name="BenchmarkProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="16"
                                 Margin="0,0,0,8"/>

                    <TextBlock x:Name="BenchmarkStatusTextBlock"
                               Text="Benchmark not started."
                               Margin="0,4,0,8"
                               Foreground="DimGray"/>

                    <TextBlock Text="Current best configuration:"
                               FontWeight="SemiBold"
                               Margin="0,4,0,4"/>

                    <TextBox x:Name="BestConfigTextBox"
                             Height="120"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock x:Name="CurrentConfigTextBlock"
                               Text="Testing: —"
                               Margin="0,4,0,4"
                               TextWrapping="Wrap" />
                    
                    <CheckBox x:Name="RunAllOrdersCheckBox"
                              Content="Run all insertion orders (DESC, ASC, ALT)"
                              Margin="0,4,0,4" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>